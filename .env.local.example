# ─── EmailJS (contact form) ───
# Sign up at https://www.emailjs.com/ and grab these from your dashboard
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_API=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key

# ─── Google Gemini (AI chatbot) ───
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_private_key

# Choose a model — defaults to gemini-2.0-flash if not set
# Options: gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro, etc.
GEMINI_MODEL=gemini-2.0-flash

# ─── Upstash Redis (chatbot rate limiting) ───
# Create a free database at https://console.upstash.com and grab the REST credentials.
# Required - without these the /api/chat route throws and the chatbot fails in production.
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
